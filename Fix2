(() => {
  const temp1 = window.__grokPortal;
  if (!temp1) {
    console.error("Nothing captured. Run the hook, then click Settings.");
    return;
  }

  let portal = temp1;
  while (portal.parentElement && !portal.parentElement.isConnected) {
    portal = portal.parentElement;
  }

  document.body.appendChild(portal);

  [portal, temp1].forEach((el) => {
    el.style.setProperty("position", "relative", "important");
    el.style.setProperty("visibility", "visible", "important");
    el.style.setProperty("opacity", "1", "important");
    el.style.setProperty("z-index", "2147483647", "important");
    el.style.setProperty("pointer-events", "auto", "important");
  });

  temp1.focus();
})();
